---
import type { HTMLAttributes } from "astro/types";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { fontVariables, preloadFontVariables } from "virtual:astro-theme-university/fonts";
import { llmsTxtHref } from "virtual:astro-theme-university/llms";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import "astro-theme-university/styles/base.css";
import "astro-theme-university/styles/components.css";
import OpenGraph from "../components/OpenGraph.astro";
import { resolveHeroImage, resolveSocialImage } from "../images.js";
import type {
  NavLink,
  SocialLink,
  ContactInfo,
  AcknowledgementInfo,
  RemoteImage,
} from "../types.js";

export interface BaseLayoutProps {
  /** Page title, used in the HTML `<title>` element. */
  title: string;
  /** Page meta description for SEO. */
  description?: string;
  /** Unlisted page: builds at its URL for anyone with the link, but stays out
   *  of the indexes — emits `<meta name="robots" content="noindex">` and marks
   *  the page `data-pagefind-ignore="all"` so the on-site search skips it. */
  unlisted?: boolean;
  /** Site name displayed in the nav and footer. */
  name?: string;
  /** Navigation links displayed in the top bar. */
  links?: NavLink[];
  /** Whether to show the search button and dialog. */
  search?: boolean;
  /** Enable Astro's `<ClientRouter>` for view transitions between pages. */
  clientRouter?: boolean;

  /** Hero section heading text. When provided, renders a Hero component. */
  heroTitle?: string;
  /** Hero background image: imported ImageMetadata, a `RemoteImage`, an
   *  absolute http(s) URL, or a `/src/assets/...` string path. */
  heroImage?: string | ImageMetadata | RemoteImage;
  /** Alt text for the hero image. Omit (or pass "") for a decorative hero. */
  heroImageAlt?: string;

  /** Card image for link previews (Open Graph / Twitter). Falls back to the
   *  site-wide `socialImage`; when neither is set the page emits no
   *  `og:image`, and so gets no card. Accepts the same forms as `heroImage`. */
  socialImage?: string | ImageMetadata | RemoteImage;
  /** Alt text for the social card image. */
  socialImageAlt?: string;
  /** `og:type` for this page; use "article" for posts, "profile" for people. */
  socialType?: "website" | "article" | "profile";

  /** Favicon. When omitted, no favicon link is emitted. */
  favicon?: ImageMetadata;
  /** Logo image (light mode), passed through to Nav. When omitted, the
   *  site name renders as a text wordmark. */
  logo?: ImageMetadata;
  /** Logo image (dark mode), passed through to Nav. */
  logoDark?: ImageMetadata;
  /** Compact logo (crest / monogram) swapped into the nav below the mobile
   *  breakpoint, passed through to Nav. */
  logoCompact?: ImageMetadata;
  /** Compact logo (dark mode), passed through to Nav. */
  logoCompactDark?: ImageMetadata;

  /** Force a specific colour scheme. 'auto' (default) lets users toggle. */
  colorScheme?: "auto" | "light" | "dark";

  /** Extra attributes spread onto the theme's `<main>` element (e.g.
   *  `data-pagefind-body` to scope search indexing to page content without
   *  wrapping the slot in an extra element, which would break `.at-main`'s
   *  subgrid placement). A `class` is merged after the theme's own
   *  `at-main`; don't pass `id` (the theme sets `id="main"` as the
   *  skip-link target). */
  mainAttrs?: HTMLAttributes<"main">;

  /** Contact details displayed in the footer. */
  contact?: ContactInfo;
  /** Social media links displayed as icons in the footer. */
  socials?: SocialLink[];
  /** SPDX licence identifier for the site content (e.g. "CC-BY-4.0"). */
  licence?: string;
  /** Institutional acknowledgement with an optional logo for the footer's
   *  dark band. The theme ships no
   *  institutional defaults — branding packages supply this as data. */
  acknowledgement?: AcknowledgementInfo;
  /** Footer legal links. */
  legalLinks?: { text: string; href: string }[];
  /** Footer partnership logo links, shown in the dark band. */
  partnerships?: { text: string; href: string; logo: string }[];
  /** Footer regulatory metadata lines (e.g. provider IDs, ABN). Each line
   *  is rendered via `set:html`, so callers can embed inline `<a>` markup;
   *  values must come from a trusted source. */
  meta?: string[];
}

type Props = BaseLayoutProps;

const {
  title,
  description,
  unlisted = false,
  name = "Site",
  links = [],
  search,
  clientRouter = true,

  heroTitle,
  heroImage,
  heroImageAlt,

  socialImage,
  socialImageAlt,
  socialType,

  favicon,
  logo,
  logoDark,
  logoCompact,
  logoCompactDark,

  colorScheme = "auto",

  mainAttrs = {},

  contact,
  socials,
  licence,
  acknowledgement,
  legalLinks,
  partnerships,
  meta,
} = Astro.props;

const { class: mainClass, ...mainRest } = mainAttrs;

const resolvedHeroImage = resolveHeroImage(heroImage);
const resolvedSocialImage = resolveSocialImage(socialImage);
---

<!doctype html>
<html lang="en" data-theme={colorScheme === "auto" ? undefined : colorScheme}>
  <head>
    <meta charset="utf-8" />
    {/* Declare the cascade-layer order up front, before any stylesheet. The
        theme's styles live in @layer at.tokens / at.base / at.components, but
        none of the CSS files declares their order, so precedence falls back to
        first-appearance. On a SidebarLayout page Astro can emit sidebar.css
        (which opens @layer at.components) ahead of base.css, registering
        at.components as the lowest layer — the at.base reset then overrides
        component styles (duplicated nav logo, misplaced sidebar). This inline
        statement pins the canonical order so rendering no longer depends on
        emission order. Keep in sync if new at.* layers are added. */}
    <style is:inline>@layer at.tokens, at.base, at.components;</style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Emit @font-face for every registered font (the theme pair plus any the
        site registers itself). Preloads default to the body font only — the
        mono font is code-only and may never be used on a given page; sites
        can widen the list via the preloadFonts integration option. */}
    {fontVariables.map((cssVariable) => (
      <Font cssVariable={cssVariable} preload={preloadFontVariables.includes(cssVariable)} />
    ))}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {unlisted && <meta name="robots" content="noindex" />}
    <OpenGraph
      title={title}
      description={description}
      name={name}
      type={socialType}
      image={resolvedSocialImage}
      imageAlt={socialImageAlt}
    />
    <meta name="generator" content={Astro.generator} />
    {favicon && <link rel="icon" type={favicon.format === "svg" ? "image/svg+xml" : undefined} href={favicon.src} />}
    {llmsTxtHref && (
      <link rel="alternate" type="text/markdown" href={llmsTxtHref} title="llms.txt" />
    )}
    {clientRouter && <ClientRouter />}
    {colorScheme === "auto" && (
      <script is:inline data-astro-rerun>
        (function () {
          var t =
            localStorage.getItem("at-theme") ||
            (matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          document.documentElement.dataset.theme = t;
          var label = t === "dark" ? "Switch to light theme" : "Switch to dark theme";
          document.querySelectorAll(".at-footer-theme-toggle").forEach(function (btn) {
            btn.setAttribute("aria-label", label);
            btn.setAttribute("title", label);
          });
        })();
      </script>
    )}
    <slot name="head" />
  </head>
  <body data-pagefind-ignore={unlisted ? "all" : undefined}>
    <a href="#main" class="visually-hidden">Skip to main content</a>
    <Nav
      name={name}
      links={links}
      search={search}
      logo={logo}
      logoDark={logoDark}
      logoCompact={logoCompact}
      logoCompactDark={logoCompactDark}
    />
    {heroTitle && resolvedHeroImage && (
      <Hero title={heroTitle} image={resolvedHeroImage} imageAlt={heroImageAlt ?? ""} />
    )}
    <slot name="hero" />
    <main id="main" class:list={["at-main", mainClass]} {...mainRest}>
      <slot />
    </main>
    <Footer name={name} contact={contact} socials={socials} licence={licence} colorScheme={colorScheme} acknowledgement={acknowledgement} legalLinks={legalLinks} partnerships={partnerships} meta={meta}>
      <slot name="footer-legal" slot="footer-legal" />
    </Footer>
  </body>
</html>
