---
import BaseLayout, { type BaseLayoutProps } from "./BaseLayout.astro";
import Hero from "../components/Hero.astro";
import { resolveHeroImage } from "../images.js";

export interface ContentLayoutProps extends BaseLayoutProps {
  /** Lead text displayed below the title. */
  description?: string | null;
  /** Use a wider content column. */
  wide?: boolean;
}

type Props = ContentLayoutProps;

const { title, description, heroImage, heroImageAlt, ...baseProps } = Astro.props;
// Resolve string forms (/src/assets paths, http(s) URLs) before handing the
// image to Hero, whose props don't admit bare strings.
const resolvedHeroImage = resolveHeroImage(heroImage);
const transitionName = `card-title-${Astro.url.pathname.replace(/^\/|\/$/g, "").replace(/\//g, "-")}`;
---

<BaseLayout title={title} description={description ?? undefined} {...baseProps}>
  <slot name="head" slot="head" />
  {
    resolvedHeroImage && (
      <Hero
        slot="hero"
        title={title}
        image={resolvedHeroImage}
        imageAlt={heroImageAlt ?? ""}
        transitionName={transitionName}
      />
    )
  }
  {!resolvedHeroImage && <h1 transition:name={transitionName}>{title}</h1>}
  {description && <p class="lead">{description}</p>}
  <slot />
</BaseLayout>
