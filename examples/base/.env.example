# Copy this file to .env for local development, or set these as environment
# variables in CI for production builds. The GitHub Pages workflow in
# .github/workflows/deploy.yml sets both from the repository name.

# Canonical site URL. Used for sitemap generation, llms.txt, and canonical
# link tags.
SITE_URL=https://www.example.edu

# Base path for subdirectory deployments, with a leading slash and no trailing
# one (e.g. /<repo> on GitHub Pages, or the group/project path on GitLab
# Pages). Leave unset for a site served from the domain root.
BASE_PATH=/my-site
