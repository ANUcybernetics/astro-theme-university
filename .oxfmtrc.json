{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "proseWrap": "always",
  "astro": { "compressHTML": "html" },
  "ignorePatterns": [".claude/", "backlog/", ".worktrees/"],
  "overrides": [
    {
      "files": ["**/*.md", "**/*.mdx"],
      "options": {
        "printWidth": 80
      }
    }
  ]
}
