{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "proseWrap": "always",
  "ignorePatterns": [
    ".claude/",
    "backlog/",
    ".worktrees/",
    "**/*.deck.svx",
    "**/*.deck.mdx",
    "**/decks/**/*.mdx"
  ],
  "svelte": true,
  "overrides": [
    {
      "files": ["**/*.md", "**/*.mdx"],
      "options": {
        "printWidth": 80
      }
    }
  ]
}
