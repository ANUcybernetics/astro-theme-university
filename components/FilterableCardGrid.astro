---
import { cardSearchText, type CardItem } from "../match-card-items.js";
import { withBase } from "../url.js";

type HeadingLevel = "h2" | "h3" | "h4";

export interface Props {
  /** Items to render and filter. */
  items: CardItem[];
  /** Number of columns in the grid. */
  columns?: 2 | 3;
  /** Accessible label for the search input. */
  label?: string;
  /** Placeholder text for the search input. */
  placeholder?: string;
  /** Message shown when the query matches no items. */
  emptyMessage?: string;
  /** Heading level for card titles. */
  headingLevel?: HeadingLevel;
  /** Optional stable id when more than one otherwise-identical grid appears on a page. */
  id?: string;
}

const {
  items,
  columns = 3,
  label = "Filter items",
  placeholder = "Filter…",
  emptyMessage = "No items match",
  headingLevel = "h3",
  id,
} = Astro.props;

function stableHash(value: string): string {
  let hash = 2166136261;
  for (let index = 0; index < value.length; index++) {
    hash ^= value.charCodeAt(index);
    hash = Math.imul(hash, 16777619);
  }
  return (hash >>> 0).toString(36);
}

const resultsId = id ?? `at-card-filter-${stableHash(`${label}|${items.map((item) => item.href).join("|")}`)}`;
const Heading = headingLevel;
---

<div class="at-card-filter" data-at-card-filter data-empty-message={emptyMessage}>
  <div class="at-card-filter-bar">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
      class="at-card-filter-icon"
    >
      <path
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="m17 17 4 4M3 11a8 8 0 1 0 16 0 8 8 0 0 0-16 0"
      ></path>
    </svg>
    <input
      type="search"
      class="at-card-filter-input"
      {placeholder}
      aria-label={label}
      aria-controls={resultsId}
      autocomplete="off"
      spellcheck="false"
      data-pagefind-ignore
      data-at-card-filter-input
    />
    <kbd class="at-card-filter-kbd" aria-hidden="true">/</kbd>
  </div>

  <p class="at-card-filter-status" aria-live="polite" aria-atomic="true" data-at-card-filter-status>
    {items.length} {items.length === 1 ? "item" : "items"}
  </p>

  <div id={resultsId} class={`at-card-grid at-card-grid--${columns}`} data-at-card-filter-results>
    {
      items.map((item) => (
        <a class="at-card" href={withBase(item.href)} data-at-card-search={cardSearchText(item)}>
          <div class="at-card-body">
            <Heading class="at-card-title">{item.title}</Heading>
            {item.badges && item.badges.length > 0 && (
              <p class="at-card-badges">
                {item.badges.map((badge) => (
                  <span class="at-card-badge">{badge}</span>
                ))}
              </p>
            )}
            {item.description && <p>{item.description}</p>}
          </div>
        </a>
      ))
    }
  </div>
  <p class="at-card-filter-empty" data-at-card-filter-empty hidden></p>
</div>

<script>
  function initializeCardFilter(root: HTMLElement) {
    if (root.dataset.atCardFilterInitialized === "true") return;
    root.dataset.atCardFilterInitialized = "true";
    const input = root.querySelector<HTMLInputElement>("[data-at-card-filter-input]");
    const results = root.querySelector<HTMLElement>("[data-at-card-filter-results]");
    const status = root.querySelector<HTMLElement>("[data-at-card-filter-status]");
    const empty = root.querySelector<HTMLElement>("[data-at-card-filter-empty]");
    const cards = [...root.querySelectorAll<HTMLElement>("[data-at-card-search]")];
    if (!input || !results || !status || !empty) return;

    function update() {
      const query = input.value.trim();
      const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const card of cards) {
        const haystack = card.dataset.atCardSearch ?? "";
        const matches = tokens.every((token) => haystack.includes(token));
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      status.textContent = query
        ? `Showing ${visible} of ${cards.length}`
        : `${cards.length} ${cards.length === 1 ? "item" : "items"}`;
      results.hidden = visible === 0;
      empty.hidden = visible !== 0;
      empty.textContent = `${root.dataset.emptyMessage ?? "No items match"}${query ? ` “${query}”.` : "."}`;
    }

    input.addEventListener("input", update);
    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && input.value) {
        event.preventDefault();
        input.value = "";
        update();
      }
    });
  }

  function initializeCardFilters() {
    document.querySelectorAll<HTMLElement>("[data-at-card-filter]").forEach((root) =>
      initializeCardFilter(root),
    );
  }

  if (document.documentElement.dataset.atCardFilterGlobalInitialized !== "true") {
    document.documentElement.dataset.atCardFilterGlobalInitialized = "true";
    document.addEventListener("keydown", (event) => {
      if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      if (target?.matches("input, textarea, [contenteditable=true]")) return;
      const input = [...document.querySelectorAll<HTMLInputElement>("[data-at-card-filter-input]")]
        .find((candidate) => candidate.getClientRects().length > 0);
      if (!input) return;
      event.preventDefault();
      input.focus();
      input.select();
    });
  }

  initializeCardFilters();
  document.addEventListener("astro:page-load", initializeCardFilters);
</script>
