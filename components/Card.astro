---
import { Image } from "astro:assets";
import type { ImageMetadata, ImageOutputFormat } from "astro";
import { imageFormat as themeImageFormat } from "virtual:astro-theme-university/images";
import { isRemoteImage } from "../images.js";
import type { RemoteImage } from "../types.js";
import { withBase } from "../url.js";

export type HeadingLevel = "h2" | "h3" | "h4";

export interface CardProps {
  /** The card heading text. */
  title: string;
  /** URL to link to. When provided, the card renders as an anchor element.
   *  Internal absolute paths (starting with `/`) are automatically prefixed
   *  with `import.meta.env.BASE_URL`. */
  href?: string;
  /** Optional card image displayed above the body. Pass an imported image for
   *  pipeline optimisation, or a `RemoteImage` for a pre-encoded external
   *  source rendered as a plain `<img>`. */
  image?: ImageMetadata | RemoteImage;
  /** Alt text for the card image. Set to a meaningful description if the image conveys information. */
  imageAlt?: string;
  /** Srcset widths (px) for the card image. The default covers the card grids up to 2x DPR. */
  imageWidths?: number[];
  /** The `sizes` attribute paired with `imageWidths`. The default matches the card-grid layout
   *  (full content column below the content breakpoint, ~24rem columns above it). */
  imageSizes?: string;
  /** Output format for the card image. Defaults to the `imageFormat` integration
   *  option, itself `"webp"` unless the site opts into something else. Ignored
   *  for an SVG source, which is always passed through unrasterised. */
  imageFormat?: ImageOutputFormat;
  /** HTML heading level for the card title. */
  headingLevel?: HeadingLevel;
}

/* Slots: the default slot is the card body, below the title. The named
 * `actions` slot takes controls that do something other than follow the card's
 * link — a copy button, a QR toggle — rendered as a badge in the card's top
 * corner. Filling it changes how a linked card is marked up (see `stretched`
 * below), so leave it empty unless the card really carries a control. */

type Props = CardProps;

const {
  title,
  href: rawHref,
  image,
  imageAlt,
  imageWidths = [320, 640, 960],
  imageSizes = "(min-width: 48rem) 24rem, 100vw",
  imageFormat = themeImageFormat,
  headingLevel = "h3",
} = Astro.props;
const resolvedImageAlt = imageAlt ?? (image ? title : "");
const remoteImage = image && isRemoteImage(image) ? image : undefined;
const localImage = image && !isRemoteImage(image) ? image : undefined;
const cardWidths = localImage ? imageWidths.filter((w) => w <= localImage.width) : [];
const cardFallbackWidth = localImage
  ? Math.min(Math.max(...imageWidths), localImage.width)
  : undefined;
// An SVG source overrides the format rather than the format rejecting the
// source, and skips the srcset — see Hero.astro for both.
const isVector = localImage?.format === "svg";
const resolvedFormat = isVector ? "svg" : imageFormat;
const sizing = isVector
  ? {}
  : { widths: cardWidths, sizes: imageSizes, width: cardFallbackWidth };
const href = rawHref ? withBase(rawHref) : undefined;
// A card carrying actions can't also be one big anchor: a <button> inside an
// <a> is invalid, and nesting one swallows the action's click. So a linked card
// with actions shrinks its anchor to the title and stretches it back over the
// whole card with a ::after overlay — the actions sit above that overlay and
// stay clickable, and the link's accessible name is the title rather than every
// word on the card. A card without actions is untouched.
const hasActions = Astro.slots.has("actions");
const stretched = Boolean(href) && hasActions;
const Tag = href && !stretched ? "a" : "div";
const Heading = headingLevel;
const transitionName = href
  ? `card-title-${href.replace(/^\/|\/$/g, "").replace(/\//g, "-")}`
  : undefined;
---

{/* href only where it means something: on a stretched card it belongs to the
    title's anchor, not to the div the card became. */}
<Tag class="at-card" {...Tag === "a" ? { href } : {}}>
  {
    localImage && (
      <div class="at-card-image-frame">
        <Image
          src={localImage}
          alt={resolvedImageAlt}
          {...sizing}
          format={resolvedFormat}
          class="at-card-image"
          loading="lazy"
        />
      </div>
    )
  }
  {
    remoteImage && (
      <div class="at-card-image-frame">
        {/* Already encoded elsewhere: a plain img, no build-time pipeline.
            `sizes` only means anything alongside a srcset, and the frame's CSS
            (aspect-ratio + object-fit) pins layout even without dimensions. */}
        <img
          src={remoteImage.src}
          srcset={remoteImage.srcset}
          sizes={remoteImage.srcset ? (remoteImage.sizes ?? imageSizes) : undefined}
          width={remoteImage.width}
          height={remoteImage.height}
          alt={resolvedImageAlt}
          class="at-card-image"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="at-card-body">
    <Heading class="at-card-title" transition:name={transitionName}>
      {stretched ? <a class="at-card-title-link" href={href}>{title}</a> : title}
    </Heading>
    <slot />
  </div>
  {
    hasActions && (
      <div class="at-card-actions">
        <slot name="actions" />
      </div>
    )
  }
</Tag>
